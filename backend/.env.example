# Production / Development Environment Variables Template

# Server Port
PORT=3001

# Environment ('development' | 'production' | 'test')
NODE_ENV=production

# PostgreSQL Database Connection String
# e.g. postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# JWT Secret - generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_64_character_random_hex_or_base64_string
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS and Helmet security headers
FRONTEND_URL=https://your-domain.com

# Stripe Keys (leave empty to use built-in Mock Mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
